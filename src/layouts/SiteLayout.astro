---
import Header from '../components/Header.astro';
import footer from '../components/footer.html?raw';

interface Props {
  head: string;
  tail: string;
  bodyAttributes: Record<string, string | boolean>;
}
const { head, tail, bodyAttributes } = Astro.props;
const pageTail = Astro.url.pathname === '/about/'
  ? tail.replace(' current-menu-item page_item page-item-9 current_page_item', '')
      .replace(' aria-current="page"', '')
      .replace('menu-item-object-page menu-item-19', 'menu-item-object-page current-menu-item page_item page-item-11 current_page_item menu-item-19')
      .replace('href="/about/"', 'href="/about/" aria-current="page"')
  : tail;
---
<!doctype html>
<html lang="ja">
  <head><Fragment set:html={head} /></head>
  <body {...bodyAttributes}>
    <div id="container" class="container cf">
      <a class="skip-link" href="#main">コンテンツへスキップ</a>
      <Header />
      <slot />
      <Fragment set:html={footer} />
    </div>
    <Fragment set:html={pageTail} />
  </body>
</html>
