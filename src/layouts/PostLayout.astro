---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import assets from '../components/head-assets.html?raw';
import sidebar from '../components/sidebar.html?raw';
import tail from '../components/page-tail.html?raw';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { title, description, publishedAt, updatedAt, categories, tags } = post.data;
const url = `https://blog.stu345.com/${post.data.slug}/`;
const escape = (value: string) => value.replace(/[&<>"']/g, c => ({'&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'}[c]!));
const head = `<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"><meta name="robots" content="noindex, nofollow"><title>${escape(title)} | Notes to Forget</title><meta name="description" content="${escape(description)}"><link rel="canonical" href="${url}"><meta property="og:title" content="${escape(title)}"><meta property="og:type" content="article"><meta property="og:url" content="${url}"><meta property="og:description" content="${escape(description)}">${assets}`;
const date = (value: Date) => value.toISOString().slice(0, 10).replaceAll('-', '.');
const bodyAttributes = { class: 'body public-page page-body single single-post ff-hiragino fz-18px fw-400 hlt-center-logo-wrap sidebar-right mblt-footer-mobile-buttons scrollable-mobile-buttons mobile-button-fmb no-mobile-sidebar font-awesome-4 thumb-wide' };
---
<SiteLayout head={head} tail={tail} bodyAttributes={bodyAttributes}>
  <div id="content" class="content cf">
    <div id="content-in" class="content-in wrap">
      <main id="main" class="main">
        <article class="article" itemscope itemtype="https://schema.org/BlogPosting">
          <header class="article-header entry-header">
            <h1 class="entry-title" itemprop="headline">{title}</h1>
            <div class="date-tags">
              <span class="post-date"><span class="fa fa-clock-o" aria-hidden="true"></span><time datetime={publishedAt.toISOString()} itemprop="datePublished">{date(publishedAt)}</time></span>
              {updatedAt && <span class="post-update"><span class="fa fa-history" aria-hidden="true"></span><time datetime={updatedAt.toISOString()} itemprop="dateModified">{date(updatedAt)}</time></span>}
            </div>
          </header>
          <div class="entry-content cf" itemprop="articleBody"><slot /></div>
          <footer class="article-footer entry-footer">
            <div class="entry-categories-tags">
              <div class="entry-categories">{categories.map(category => <span class="cat-link">{category}</span>)}</div>
              <div class="entry-tags">{tags.map(tag => <span class="tag-link border-element">{tag}</span>)}</div>
            </div>
          </footer>
        </article>
      </main>
      <Fragment set:html={sidebar} />
    </div>
  </div>
</SiteLayout>
