---
import { content, archives, postPath } from "../lib/content";
import ContentView from "../components/ContentView.astro";
import ArchiveView from "../components/ArchiveView.astro";
export async function getStaticPaths() {
  const { posts, pages } = await content();
  const entries = [...posts, ...pages].filter((p) => postPath(p) !== "/");
  const paths = [
    ...entries.map((post) => ({
      params: { slug: postPath(post).slice(1, -1) },
      props: { post, archive: null },
    })),
    ...archives(posts).map((archive) => ({
      params: { slug: decodeURIComponent(archive.path.slice(1, -1)) },
      props: { post: null, archive },
    })),
  ];
  const seen = new Set<string>();
  for (const path of paths) {
    if (seen.has(path.params.slug))
      throw new Error(`Duplicate path: ${path.params.slug}`);
    seen.add(path.params.slug);
  }
  return paths;
}
const { post, archive } = Astro.props;
---

{post ? <ContentView {post} /> : <ArchiveView {archive} />}
